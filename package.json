{
  "name": "wangs-agent",
  "version": "0.4.1",
  "description": "Standalone interactive terminal chat CLI for Wangs Foundation projects, built on the Claude Agent SDK. Behaves like a general-purpose coding agent for everyday work; routes end-to-end feature builds through its own deterministic, gated pipeline (real command gates, never model self-judgment) instead of freeform agent judgment.",
  "license": "MIT",
  "bin": {
    "wangs-agent": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "wangs-plugin",
    "rules"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "type-check": "tsc --noEmit",
    "lint": "oxlint src scripts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "dev": "bun src/cli.ts",
    "docs:preview": "bun run scripts/serve-docs.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.274",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/node": "^24.13.3",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.75.0",
    "tsdown": "^0.22.14",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
