{
  "name": "wangs-code",
  "version": "1.8.10",
  "description": "Standalone interactive terminal chat CLI (requires Bun) for Wangs Foundation projects, built on the Claude Agent SDK. Behaves like a general-purpose coding agent for everyday work; routes end-to-end feature builds through its own deterministic, gated pipeline (real command gates, never model self-judgment) instead of freeform agent judgment.",
  "license": "MIT",
  "bin": {
    "wangs-code": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "wangs-plugin",
    "rules",
    "assets"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "type-check": "tsc --noEmit",
    "lint": "oxlint src scripts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "dev": "bun src/cli.ts",
    "dev:watch": "bun --watch src/cli.ts",
    "docs:preview": "bun run scripts/serve-docs.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.274",
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "pg": "^8.13.0",
    "react": "^19.2.0",
    "react-devtools-core": "^7.0.1",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.75.0",
    "tsdown": "^0.22.14",
    "typescript": "~6.0.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishRegistry": "http://192.168.1.102:4873/"
}
